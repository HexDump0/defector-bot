   "ownerName": null,
   "source": "export default function ({ history, memory }) {\n  let m = memory || { bad: 0 };\n  \n  if (!history.length) {\n    return [\"C\", m];\n  }\n\n  let oppLast = history[history.length - 1].opponent;\n  if (oppLast === \"D\") m.bad++;\n\n  return [m.bad / history.length > 0.25 ? \"D\" : oppLast, m];\n}",
