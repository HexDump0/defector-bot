   "description": "w",
   "id": "3bdmy2qwojynbk2rmsmc",
   "meanScore": 1.695851351061381,
   "name": "p3d",
   "ownerName": null,
   "source": "export default function bot({ history = [], memory }) { const m = (memory && typeof memory === 'object') ? memory : { d: 0, grudge: 0 }; m.d = Number.isFinite(m.d) ? m.d : 0; m.grudge = Number.isFinite(m.grudge) ? m.grudge : 0; if (history.length === 0) return [\"C\", m]; const opponentMove = history[history.length - 1].opponent; if (opponentMove === \"D\") { m.d++; if (m.d >= 2) m.grudge = 1; } else { m.d = 0; if (m.grudge) { m.grudge++; if (m.grudge >= 4) m.grudge = 0; } } if (m.grudge === 1) return [\"D\", m]; return [opponentMove === \"C\" ? \"C\" : \"D\", m]; }\n",
   "stats": {
