   "description": "yeah, tit for two tats",
   "id": "ckuyl3k3452cldvlfyhw",
   "meanScore": 1.6070186561453437,
   "name": "Tit for Two Tats",
   "ownerName": null,
   "source": "export default function bot({ history }) {\n\n    if (history.length < 2) {\n        return [\"C\", null];\n    }\n\n    const lastOppMove = history.at(-1).opponent;\n    const prevOppMove = history.at(-2).opponent;\n\n    if (lastOppMove === \"D\" && prevOppMove === \"D\") {\n        return [\"D\", null];\n    }\n\n    return [\"C\", null];\n}",
