   "description": "Bot that randomly moves if the opponent isnt predictable",
   "id": "q13jnl8k1jlxfq3c1d58",
   "meanScore": 1.1827085762426122,
   "name": "RanBot3003",
   "ownerName": null,
   "source": "export default function bot({ history, memory }) {\n    if (!memory) {\n        memory = {};\n    }\n    if (history.length === 0) {\n        return ['C', memory];\n    }\n    let opponentOnlyCooperate = true;\n    let opponentOnlyDeflect = true;\n    history.forEach(match => {\n        if (match.opponent == 'D') {\n            opponentOnlyCooperate = false;\n        }\n        if (match.opponent == 'C') {\n            opponentOnlyDeflect = false;\n        }\n    });\n    if (opponentOnlyCooperate || opponentOnlyDeflect) {\n        return ['D', memory];\n    }\n    if (Math.random() >= 0.5) {\n        return ['C', memory];\n    }\n    else {\n        return ['D', memory];\n    }\n}\n//# sourceMappingURL=bot1.js.map",
