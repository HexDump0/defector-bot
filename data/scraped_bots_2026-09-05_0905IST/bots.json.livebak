   "source": "// flipflopper\nexport default function bot({ history, memory }) {\n    let move\n    if (memory == null || memory == \"D\") {\n        move = \"C\"\n    } else {\n        move = \"D\"\n    }\n    memory = move\n\n    return [move, memory]\n}",
