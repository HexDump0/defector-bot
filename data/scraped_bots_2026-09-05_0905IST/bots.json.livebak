   "source": "export default function bottlev2({history, memory}){\n    let n = history.length - 1\n    let move\n    let C\n    let opp\n    let D\n    const opp0 = history[0]\n    const opp1 = history[1]\n    const opp2 = history[2]\n    if (history.length == 0){\n        move = \"C\"\n    }\n    else{\n        opp = history[n].opponent\n        if(opp == \"C\"){\n            C = 1\n        }\n        else if(opp == \"D\"){\n            D += 1\n        }\n        if(D > 2){\n            if(memory > 0&&C > 0){\n                move = \"C\"\n                memory = 0\n                C = 0\n            }\n            else if (memory > 0){    \n             move = \"D\"\n            }\n            else if(opp == \"C\"){\n               move = \"C\"\n            }\n            else if (opp == \"D\"){\n              move = \"D\"\n              memory = 1\n            }\n        }\n        else if(opp0 === \"D\"&& opp1 === \"C\"&& opp2 === \"C\"){\n            move = \"D\"\n        }\n        else{\n            if(memory > 0&&C > 0){\n                move = \"C\"\n                memory = 0\n                C = 0\n            }\n            else if (memory > 0){    \n             move = \"D\"\n            }\n            else if(opp == \"C\"){\n               move = \"C\"\n            }\n            else if (opp == \"D\"){\n              move = \"D\"\n              memory = 1\n            }\n        }\n    }\n    return [move, memory]\n}",
   "stats": {
