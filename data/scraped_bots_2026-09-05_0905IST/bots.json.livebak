   "source": "export default function({history, mem}){\n    let hasdefected=false;\n    const N = history.length;\n    if(N==0){ return [\"D\", null]}\n    for(let i = 0; i<N; i++){\n        if(history[i].opponent == \"D\"){hasdefected=true;}\n    }\n    if(hasdefected) {return [\"D\", null]}\n    else {return [\"C\", null]}\n}",
