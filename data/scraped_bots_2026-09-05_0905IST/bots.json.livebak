   "ownerName": null,
   "source": "export default function bot({ history }) {\n  if (history.length === 0) {\n    return [\"C\", null] // Start by cooperating\n  }\n\n  const { you, opponent } = history.at(-1)\n\n  const move = opponent === \"C\"\n    ? you                          // win \u2192 stay\n    : (you === \"C\" ? \"D\" : \"C\")    // lose \u2192 shift\n\n  return [move, null]\n}",
