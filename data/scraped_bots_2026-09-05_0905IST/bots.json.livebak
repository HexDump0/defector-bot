92,27],[1,-1,893,28],[1,-1,894,29],[1,-1,895,30],[1,-1,896,31],[1,-1,897,32],[1,-1,898,33],[1,-1,899,34],[1,-1,900,35],[1,-1,901,36],[1,-1,902,37],[1,-1,903,38],[1,-1,904,39],[-1,0,40,-1]];\n\nfunction treeMove(h) {\n  let k=0;\n  for(let i=0;i<h.length;i++) {\n    const node=TREE[k];\n    if(node[0]===-1)break;\n    if(h[i].you !== (node[0]?'D':'C'))return policy(0,h,0);\n    k=node[h[i].opponent==='D'?2:1];\n    if(k<0)return policy(0,h,0);\n  }\n  const node=TREE[k];\n  if(node[0]===-1)return policy(node[1],h,node[2]);\n  return node[0]?'D':'C';\n}\n\n// Exported strategy. Signature/behavior mirrors the original populationBot:\n// takes {history}, returns [move, newState] (state is unused/stateless here,\n// like the original -- everything needed is recomputed from history).\nexport default function populationBot({ history }) {\n  try {\n    const h = Array.isArray(history) ? history : [];\n\n    // Sanity-check each entry defensively so a malformed/foreign history array\n    // can never throw mid-decision (a thrown error forfeits the match 0:3).\n    for (let i = 0; i < h.length; i++) {\n      const r = h[i];\n      if (!r || (r.you !== 'C' && r.you !== 'D') || (r.opponent !== 'C' && r.opponent !== 'D')) {\n        return ['D', null];\n      }\n    }\n\n    // Hard anti-farming guard: a partner that has just gone into sustained\n    // defection must not be met with a stale cooperative leaf from the tree.\n    if (h.length >= 8 && h.slice(-5).every(r => r.opponent === 'D')) return ['D', null];\n\n    // Fixed, un-reactive periodic defectors are punished, not farmed, even if\n    // their opening moves happen to resemble a recognized archetype.\n    if (isUnconditionalPeriodic(h)) return ['D', null];\n\n    return [treeMove(h), null];\n  } catch {\n    return ['D', null];\n  }\n}",
