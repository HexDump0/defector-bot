   "ownerName": null,
   "source": "export default function ({ history }) {\n    if (history.length < 2) \n        return [\"D\", null]\n\n    let oneback = history[history.length - 1].opponent\n    let twoback = history[history.length - 2].opponent\n\n    if (oneback === \"D\" && twoback === \"D\")\n        return [\"D\", null]; \n    else\n        return [\"C\", null]; \n    \n}\n\n",
