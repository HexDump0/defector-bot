   "description": "YK",
   "id": "i5o8d2m5elmjoccm5s31",
   "meanScore": 1.6229046838452172,
   "name": "Czechias imperium",
   "ownerName": null,
   "source": "export default function bottle({history, memory}){\n    let n = history.length - 1\n    let move\n    let C = 0\n    let opp\n    if (history.length == 0){\n        move = \"C\"\n    }\n    else{\n        opp = history[n].opponent\n        if(opp == \"C\"){\n            C += 1\n        }\n\n        if(memory > 0&&C > 2){\n            move = \"C\"\n            memory = 0\n            C = 0\n        }\n        else if (memory > 0){    \n            move = \"D\"\n        }\n        else if(opp == \"C\"){\n            move = \"C\"\n        }\n        else if (opp == \"D\"){\n           move = \"D\"\n           memory = 1\n        }\n        \n    }\n    return [move, memory]\n}",
