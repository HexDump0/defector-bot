   "meanScore": 1.1721553907512492,
   "name": "Statistical\ud83e\udd13",
   "ownerName": null,
   "source": "export default function bot({ history, memory }) {\n  memory = memory ?? { weWon: false }\n\n  if (history.length === 0) {\n    return [\"D\", memory] // First move\n  }\n\n  const lastOpponentMove = history.at(-1)?.opponent\n  const lastMove = history.at(-1)?.you\n\n  if (lastOpponentMove === \"D\") {\n    memory.weWon = false\n  } else {\n    memory.weWon = true\n  }\n\n  if (memory.weWon) {\n    return [lastMove, memory]\n  } else {\n    const move = lastMove === \"C\" ? \"D\" : \"C\"\n    return [move, memory]\n  }\n}",
