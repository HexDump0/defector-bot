   "description": "Tit for tat, but backwards",
   "id": "xhtfwtmne5mo0csil1gw",
   "meanScore": 0.7856242988911722,
   "name": "Reverse Tit for Tat",
   "ownerName": null,
   "source": "export default function bot({ history }) {\n  if (history.length === 0)\n    return [\"D\", null] // Defect on the first round\n  const move = history.at(-1).opponent\n  if (move == \"C\")\n    return [\"D\", null]\n  else\n    return [\"C\", null]\n}",
